<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Anwendung. -->
    <x:String x:Key="AppTitle">Avalonia MVVM Studio</x:String>

    <!-- Hauptnavigation. -->
    <x:String x:Key="DashboardTitle">Dashboard</x:String>
    <x:String x:Key="DashboardSubTitle">Sources, requests, dashboards and designer workspace.</x:String>

    <x:String x:Key="AppSettingsTitle">Settings</x:String>
    <x:String x:Key="AppSettingsSubTitle">Application configuration and runtime options.</x:String>
    <x:String x:Key="AppSettingsApiUrlLabel">API URL</x:String>
    <x:String x:Key="AppSettingsApiUrlPreviewLabel">Current API URL</x:String>

    <x:String x:Key="AboutTitle">About</x:String>
    <x:String x:Key="AboutSubTitle">Legal information and application details.</x:String>

    <x:String x:Key="LogoutButton">Logout</x:String>

    <!-- Gemeinsam verwendete Aktionen. -->
    <x:String x:Key="CreateAction">Create</x:String>
    <x:String x:Key="EditAction">Edit</x:String>
    <x:String x:Key="DeleteAction">Delete</x:String>
    <x:String x:Key="SaveAction">Save</x:String>
    <x:String x:Key="MoreActions">⋯</x:String>

    <!-- Quellen- und Request-Navigation des Dashboards. -->
    <x:String x:Key="SourcesTitle">Sources</x:String>
    <x:String x:Key="SourcesSubtitle">Top-level source definitions</x:String>
    <x:String x:Key="CreateSourceAction">New Source</x:String>

    <x:String x:Key="RequestsTitle">Requests</x:String>
    <x:String x:Key="RequestsSubtitle">Requests for selected source</x:String>
    <x:String x:Key="CreateRequestAction">New Request</x:String>

    <x:String x:Key="NoSourceBaseUrl">No base URL configured</x:String>
    <x:String x:Key="NoRequestMethod">No method configured</x:String>

    <!-- Request-Arbeitsbereich. -->
    <x:String x:Key="DataDashboardTab">Data Dashboard</x:String>
    <x:String x:Key="DashboardDesignerTab">Dashboard Designer</x:String>
    
    <x:String x:Key="RequestTabsToggleAction">Tabs</x:String>
    <x:String x:Key="CloseTabAction">Close</x:String>

    <!-- Quellenkonfiguration. -->
    <x:String x:Key="SourceConfiguratorTitle">Source Configuration</x:String>
    <x:String x:Key="SourceConfiguratorSubtitle">Edit source details and save when ready.</x:String>
    <x:String x:Key="SourceNameLabel">Name</x:String>
    <x:String x:Key="SourceBaseUrlLabel">Default Base URL</x:String>
    <x:String x:Key="SourceDescriptionLabel">Description</x:String>
    <x:String x:Key="SourceAuthenticationTypeLabel">Authentication Type</x:String>
    <x:String x:Key="SourceApiKeyLabel">API Key</x:String>
    <x:String x:Key="SourceDefaultHeaderLabel">Default Header</x:String>
    <x:String x:Key="SaveSourceAction">Save Source</x:String>

    <!-- Request-Konfiguration. -->
    <x:String x:Key="RequestConfiguratorTitle">Request Configuration</x:String>
    <x:String x:Key="RequestConfiguratorSubtitle">Edit request details and save when ready.</x:String>
    <x:String x:Key="RequestNameLabel">Name</x:String>
    <x:String x:Key="RequestEndpointPathLabel">Endpoint Path</x:String>
    <x:String x:Key="RequestHttpMethodLabel">HTTP Method</x:String>
    <x:String x:Key="RequestQueryParametersLabel">Query String Parameters</x:String>
    <x:String x:Key="RequestHeaderLabel">Request Header</x:String>
    <x:String x:Key="RequestBodyLabel">Request Body</x:String>
    <x:String x:Key="RequestPollingIntervalLabel">Polling Interval</x:String>
    <x:String x:Key="RequestIsActiveLabel">Is Active</x:String>
    <x:String x:Key="SaveRequestAction">Save Request</x:String>
    
    <!-- Loeschbestaetigung. -->
    <x:String x:Key="DeleteSourceDialogTitle">Delete source?</x:String>
    <x:String x:Key="DeleteSourceDialogMessage">This will delete the source, all requests inside it, and all data connected to those requests. This action cannot be undone.</x:String>

    <x:String x:Key="DeleteRequestDialogTitle">Delete request?</x:String>
    <x:String x:Key="DeleteRequestDialogMessage">This will delete the request and all data connected to it. This action cannot be undone.</x:String>

    <x:String x:Key="CancelAction">Cancel</x:String>
    <x:String x:Key="ConfirmDeleteAction">Delete</x:String>
    
    <!-- Datenausgabe. -->
    <x:String x:Key="DataDashboardTitle">Data Dashboard</x:String>
    <x:String x:Key="DataDashboardSubtitle">Request output preview will appear here.</x:String>
    <x:String x:Key="DataDashboardPlaceholderTitle">No data preview yet</x:String>
    <x:String x:Key="DataDashboardPlaceholderText">JSON entry rendering will be implemented in the next step.</x:String>

    <!-- Dashboard-Designer. -->
    <x:String x:Key="DashboardDesignerTitle">Dashboard Designer</x:String>
    <x:String x:Key="DashboardDesignerSubtitle">Design request dashboard widgets and layout.</x:String>
    <x:String x:Key="DashboardDesignerPlaceholderTitle">Designer canvas placeholder</x:String>
    <x:String x:Key="DashboardDesignerPlaceholderText">Dashboard layout tools will be added later.</x:String>

    <!-- Programminformationen. -->
    <x:String x:Key="AboutLegalInfo">
