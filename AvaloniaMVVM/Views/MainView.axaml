<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:AvaloniaMVVM.ViewModels"
        xmlns:models="using:AvaloniaMVVM.Models"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="760"
        x:Class="AvaloniaMVVM.Views.MainView"
        x:DataType="vm:MainVm"
        Icon="/Assets/avalonia-logo.ico"
        Title="{DynamicResource AppTitle}"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Schmale Hauptnavigation für die oberste Anwendungsebene. -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource MainSidebarBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="8">

            <StackPanel Spacing="8">

                <Button Classes="sidebar"
                        Classes.selected="{Binding IsDashboardSelected}"
                        ToolTip.Tip="{DynamicResource DashboardTitle}"
                        Command="{Binding Navigate}"
                        CommandParameter="{x:Static models:MainNavigationPosition.Dashboard}">

                    <icons:MaterialIcon Kind="Home"
                                        Width="26"
                                        Height="26"
                                        VerticalAlignment="Center"/>
                </Button>

                <Button Classes="sidebar"
                        Classes.selected="{Binding IsAppSettingsSelected}"
                        ToolTip.Tip="{DynamicResource AppSettingsTitle}"
                        Command="{Binding Navigate}"
                        CommandParameter="{x:Static models:MainNavigationPosition.AppSettings}">

                    <icons:MaterialIcon Kind="Settings"
                                        Width="26"
                                        Height="26"
                                        VerticalAlignment="Center"/>
                </Button>

                <Button Classes="sidebar"
                        Classes.selected="{Binding IsAboutSelected}"
                        ToolTip.Tip="{DynamicResource AboutTitle}"
                        Command="{Binding Navigate}"
                        CommandParameter="{x:Static models:MainNavigationPosition.About}">

                    <icons:MaterialIcon Kind="About"
                                        Width="26"
                                        Height="26"
                                        VerticalAlignment="Center"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- Jede Seite verwaltet ihr Scrollverhalten selbst. -->
        <Border Grid.Row="0"
                Grid.Column="1"
                Background="{DynamicResource AppBackgroundBrush}">

            <ContentControl Content="{Binding NavigationService.CurrentViewModel}"/>

        </Border>

        <!-- Die Statusleiste bleibt unabhängig von der aktuellen Seite sichtbar. -->
        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Content="{Binding StatusBarVm}"/>
    </Grid>
</Window>