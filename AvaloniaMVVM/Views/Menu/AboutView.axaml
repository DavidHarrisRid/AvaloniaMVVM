<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaMVVM.Views.Menu.AboutView">
    
    <StackPanel Spacing="12" Margin="20">
        <TextBlock
            Text="{DynamicResource AboutTitle}"
            FontSize="24"
            FontWeight="Bold" />

        <Border Padding="5"></Border>
        
        <TextBlock
            Text="{DynamicResource AboutSubTitle}" />
                
        <Border Padding="5"></Border>
        
        <TextBlock
            Text="{DynamicResource AboutVersionInfo}"/>
        
        <Border Padding="5"></Border>
        
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <TextBlock
                Text="{DynamicResource AboutLegalInfo}" TextAlignment="Center" Margin="12" TextWrapping="Wrap"/>
        </Border>
        
    </StackPanel>
    
</UserControl>

