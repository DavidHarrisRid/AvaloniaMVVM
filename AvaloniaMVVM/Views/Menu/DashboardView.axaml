<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AvaloniaMVVM.Models"
             xmlns:behaviors="clr-namespace:AvaloniaMVVM.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaMVVM.ViewModels.Menu"
             mc:Ignorable="d"
             x:Name="Root"
             x:DataType="vm:DashboardVm"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="AvaloniaMVVM.Views.Menu.DashboardView">

    <!-- Root-Container fuer Inhalt und modales Overlay. -->
    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <!-- Der normale Dashboard-Inhalt wird bei geoeffnetem Dialog vollstaendig deaktiviert. -->
        <Grid IsEnabled="{Binding !DeleteConfirmationService.IsOpen}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarColumnWidth}"
                                  MinWidth="260"
                                  MaxWidth="400"/>

                <ColumnDefinition Width="4"/>

                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Gemeinsamer Baum fuer Quellen und ihre Anfragen. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelAltBrush}"
                    IsVisible="{Binding IsSidebarVisible}">

                <Grid RowDefinitions="Auto,*">

                    <!-- Kopfbereich des Quellenbaums. -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelColor}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{DynamicResource SourcesTitle}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{DynamicResource SourcesSubtitle}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="icon accent"
                                    Content="+"
                                    ToolTip.Tip="{DynamicResource CreateSourceAction}"
                                    Command="{Binding CreateSourceCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Der Quellenbaum scrollt unabhaengig vom Hauptinhalt. -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding Sources}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ApiSourceModel">

                                    <StackPanel>

                                        <!-- Quellenknoten. -->
                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              Margin="5,2"
                                              ColumnSpacing="5">

                                            <Button Grid.Column="0"
                                                    Classes="listRow"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="7,6"
                                                    Command="{ReflectionBinding DataContext.ToggleSourceCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}">

                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="8"
                                                      HorizontalAlignment="Stretch">

                                                    <!-- Markierung fuer einen geschlossenen Knoten. -->
                                                    <TextBlock Grid.Column="0"
                                                               Width="18"
                                                               Text="▸"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               IsVisible="{Binding !IsExpanded}"/>

                                                    <!-- Markierung fuer einen geoeffneten Knoten. -->
                                                    <TextBlock Grid.Column="0"
                                                               Width="18"
                                                               Text="▾"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               IsVisible="{Binding IsExpanded}"/>

                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2">

                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="Medium"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Text="{Binding DefaultBaseUrl}"
                                                                   FontSize="11"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!-- Legt eine neue Anfrage direkt unter dieser Quelle an. -->
                                            <Button Grid.Column="1"
                                                    Classes="icon"
                                                    Content="+"
                                                    ToolTip.Tip="{DynamicResource CreateRequestAction}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Command="{ReflectionBinding DataContext.CreateRequestForSourceCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Kontextaktionen der Quelle. -->
                                            <Button Grid.Column="2"
                                                    Classes="icon"
                                                    Content="{DynamicResource MoreActions}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">

                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="{DynamicResource EditAction}"
                                                                  Command="{ReflectionBinding DataContext.EditSourceCommand, ElementName=Root}"
                                                                  CommandParameter="{Binding}"/>

                                                        <MenuItem Header="{DynamicResource DeleteAction}"
                                                                  Command="{ReflectionBinding DataContext.DeleteSourceCommand, ElementName=Root}"
                                                                  CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>

                                            </Button>
                                        </Grid>

                                        <!-- Untergeordnete Anfragen der geoeffneten Quelle. -->
                                        <ItemsControl ItemsSource="{Binding ApiRequests}"
                                                      IsVisible="{Binding IsExpanded}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ApiRequestModel">

                                                    <Grid ColumnDefinitions="*,Auto"
                                                          Margin="30,1,5,1"
                                                          ColumnSpacing="5">

                                                        <Button Grid.Column="0"
                                                                Classes="listRow"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Padding="7,5"
                                                                Command="{ReflectionBinding DataContext.OpenRequestCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}">

                                                            <Grid ColumnDefinitions="Auto,*"
                                                                  ColumnSpacing="8"
                                                                  HorizontalAlignment="Stretch">

                                                                <TextBlock Grid.Column="0"
                                                                           Text="•"
                                                                           FontSize="16"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"/>

                                                                <StackPanel Grid.Column="1"
                                                                            Spacing="2">

                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="14"
                                                                               FontWeight="Medium"
                                                                               TextTrimming="CharacterEllipsis"/>

                                                                    <TextBlock Text="{Binding HttpMethod}"
                                                                               FontSize="11"
                                                                               FontWeight="Medium"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <!-- Kontextaktionen der Anfrage. -->
                                                        <Button Grid.Column="1"
                                                                Classes="icon"
                                                                Content="{DynamicResource MoreActions}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">

                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Header="{DynamicResource EditAction}"
                                                                              Command="{ReflectionBinding DataContext.EditRequestCommand, ElementName=Root}"
                                                                              CommandParameter="{Binding}"/>

                                                                    <MenuItem Header="{DynamicResource DeleteAction}"
                                                                              Command="{ReflectionBinding DataContext.DeleteRequestCommand, ElementName=Root}"
                                                                              CommandParameter="{Binding}"/>
                                                                </MenuFlyout>
                                                            </Button.Flyout>

                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Mit dem Splitter laesst sich die Breite der Seitenleiste anpassen. -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="{DynamicResource PanelBorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsSidebarVisible}"/>

            <!-- Hauptbereich fuer Editoren und Request-Arbeitsflaeche. -->
            <Border Grid.Column="{Binding MainContentColumn}"
                    Grid.ColumnSpan="{Binding MainContentColumnSpan}"
                    Background="{DynamicResource AppBackgroundBrush}">

                <Grid RowDefinitions="Auto,*">

                    <!-- Kopfbereich des Request-Arbeitsbereichs. -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelColor}"
                            Padding="14,8,14,8">

                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="8">

                            <!-- Oben stehen Request-Tabs und der Umschalter fuer den Tab-Modus. -->
                            <Grid Grid.Row="0"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  MinHeight="38">

                                <!-- Geoeffnete Anfragen lassen sich als Tabs wechseln und sortieren. -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource PanelAltBrush}"
                                        CornerRadius="10"
                                        Padding="6"
                                        IsVisible="{Binding IsRequestTabStripVisible}">

                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">

                                        <ItemsControl ItemsSource="{Binding OpenRequestTabs}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RequestWorkspaceTabVm">

                                                    <Grid ColumnDefinitions="*,Auto"
                                                          Background="Transparent"
                                                          MinHeight="32"
                                                          Margin="0"
                                                          Cursor="Hand"
                                                          behaviors:RequestTabDragDropBehavior.Tab="{Binding}"
                                                          behaviors:RequestTabDragDropBehavior.ReorderCommand="{ReflectionBinding DataContext.ReorderRequestTabCommand, ElementName=Root}">

                                                        <Button Grid.Column="0"
                                                                Classes="requestTab"
                                                                MinWidth="140"
                                                                Content="{Binding Request.Name}"
                                                                Command="{ReflectionBinding DataContext.SelectRequestTabCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}"/>

                                                        <Button Grid.Column="1"
                                                                Classes="tabClose"
                                                                Content="x"
                                                                Width="26"
                                                                Height="26"
                                                                Margin="-29,3,3,3"
                                                                ToolTip.Tip="{DynamicResource CloseTabAction}"
                                                                Command="{ReflectionBinding DataContext.CloseRequestTabCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Schaltet zwischen Tab- und Einzelansicht um. -->
                                <Button Grid.Column="1"
                                        Classes="accent"
                                        Content="{DynamicResource RequestTabsToggleAction}"
                                        MinWidth="72"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding IsTabsToggleVisible}"
                                        Command="{Binding ToggleRequestTabsCommand}"/>
                            </Grid>

                            <!-- Inhaltsnavigation fuer Datenausgabe und Dashboard-Designer. -->
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding IsRequestWorkspaceVisible}">

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right">

                                    <Button Classes="workspaceMode"
                                            Content="{DynamicResource DataDashboardTab}"
                                            Command="{Binding NavigateSourceContentCommand}"
                                            CommandParameter="{x:Static models:SourceNavigationPosition.DataDashboard}"/>

                                    <Button Classes="workspaceMode"
                                            Content="{DynamicResource DashboardDesignerTab}"
                                            Command="{Binding NavigateSourceContentCommand}"
                                            CommandParameter="{x:Static models:SourceNavigationPosition.DashboardDesigner}"/>

                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Der sichtbare Hauptinhalt besitzt einen eigenen Scrollbereich. -->
                    <Grid Grid.Row="1"
                          Background="{DynamicResource AppBackgroundBrush}">

                        <ScrollViewer IsVisible="{Binding IsSourceEditorOpen}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <Border Padding="20">
                                <ContentControl Content="{Binding SourceConfiguratorVm}"/>
                            </Border>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsRequestEditorOpen}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <Border Padding="20">
                                <ContentControl Content="{Binding RequestConfiguratorVm}"/>
                            </Border>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsRequestWorkspaceVisible}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">

                            <Border Padding="20">
                                <ContentControl Content="{Binding SourceNavigationService.CurrentViewModel}"/>
                            </Border>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Modale Loeschbestaetigung blockiert den darunterliegenden Inhalt. -->
        <Grid IsVisible="{Binding DeleteConfirmationService.IsOpen}"
              Background="#99000000"
              Panel.ZIndex="100"
              Focusable="True">

            <Border Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22">

                <StackPanel Spacing="16">

                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding DeleteConfirmationService.Title}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding DeleteConfirmationService.Message}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">

                        <Button 
                                MinWidth="96"
                                Focusable="True"
                                Content="{DynamicResource CancelAction}"
                                Command="{Binding CancelDeleteCommand}"/>

                        <Button Classes="danger"
                                MinWidth="96"
                                Content="{DynamicResource ConfirmDeleteAction}"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>