<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AvaloniaMVVM.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaMVVM.ViewModels.Menu"
             mc:Ignorable="d"
             x:DataType="vm:DashboardVm"
             d:DesignWidth="1200"
             d:DesignHeight="700"
             x:Class="AvaloniaMVVM.Views.Menu.DashboardView">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left navigation area: Sources + Requests next to each other -->
            <ColumnDefinition Width="520"
                              MinWidth="420"/>

            <!-- Main dynamic content area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEVEL 1 + LEVEL 2: full-height source/request navigation -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                Padding="12">

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <!-- LEVEL 1: Sources -->
                <Border Grid.Column="0"
                        Padding="8"
                        Background="#14000000"
                        CornerRadius="8">

                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="10">

                        <!-- Sources header -->
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Sources"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>

                            <Button Content="+"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CreateSourceCommand}"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>

                        <!-- Source list -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource}">

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ApiSourceModel">
                                    <Grid ColumnDefinitions="*,Auto"
                                          Margin="0,2">

                                        <!-- No command here. The ListBox SelectedItem does the selection. -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Padding="8"/>

                                        <Button Grid.Column="1"
                                                Content="⋯"
                                                Width="32"
                                                Margin="6,0,0,0"/>

                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </Border>

                <!-- LEVEL 2: Requests for selected source -->
                <Border Grid.Column="1"
                        Padding="8"
                        Background="#14000000"
                        CornerRadius="8">

                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="10">

                        <!-- Requests header -->
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Requests"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>

                            <Button Content="+"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CreateRequestCommand}"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>

                        <!-- Request list -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Requests}"
                                 SelectedItem="{Binding SelectedRequest}">

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ApiRequestModel">

                                    <!-- No command here. The ListBox SelectedItem does the selection. -->
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Padding="8"
                                               Margin="0,2"/>

                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- LEVEL 3: main dynamic source content -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">

            <!-- Top tabs -->
            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    Padding="8">

                <StackPanel Orientation="Horizontal"
                            Spacing="8">

                    <Button Content="Config Request"
                            Command="{Binding NavigateSourceContentCommand}"
                            CommandParameter="{x:Static models:SourceNavigationPosition.Configurator}"/>

                    <Button Content="Data Dashboard"
                            Command="{Binding NavigateSourceContentCommand}"
                            CommandParameter="{x:Static models:SourceNavigationPosition.Dashboard}"/>

                    <Button Content="Dashboard Designer"
                            Command="{Binding NavigateSourceContentCommand}"
                            CommandParameter="{x:Static models:SourceNavigationPosition.Designer}"/>

                </StackPanel>
            </Border>

            <!-- Dynamic content from SourceNavigationService -->
            <Border Grid.Row="1"
                    Padding="16">

                <ContentControl Content="{Binding SourceNavigationService.CurrentViewModel}"/>

            </Border>
        </Grid>
    </Grid>
</UserControl>