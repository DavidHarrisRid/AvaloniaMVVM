<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AvaloniaMVVM.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaMVVM.ViewModels.Menu"
             mc:Ignorable="d"
             x:Name="Root"
             x:DataType="vm:DashboardVm"
             d:DesignWidth="1200"
             d:DesignHeight="700"
             x:Class="AvaloniaMVVM.Views.Menu.DashboardView">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left navigation area: Sources + Requests next to each other -->
            <ColumnDefinition Width="520"
                              MinWidth="420"/>

            <!-- Main dynamic content area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEVEL 1 + LEVEL 2: source/request navigation -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                Padding="12">

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <!-- LEVEL 1: Sources -->
                <Border Grid.Column="0"
                        Padding="8"
                        Background="#14000000"
                        CornerRadius="8">

                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="10">

                        <!-- Sources header -->
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Objects"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>

                            <Button Content="+"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CreateSourceCommand}"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>

                        <!-- Source list -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource}">

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ApiSourceModel">
                                    <Grid ColumnDefinitions="*,Auto"
                                          Margin="0,2">

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Padding="8"/>

                                        <Button Grid.Column="1"
                                                Content="⋯"
                                                Width="32"
                                                Margin="6,0,0,0">

                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Edit"
                                                              Command="{ReflectionBinding DataContext.EditSourceCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>

                                                    <MenuItem Header="Delete"
                                                              Command="{ReflectionBinding DataContext.DeleteSourceCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>

                                        </Button>

                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </Border>

                <!-- LEVEL 2: Requests for selected source -->
                <Border Grid.Column="1"
                        Padding="8"
                        Background="#14000000"
                        CornerRadius="8">

                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="10">

                        <!-- Requests header -->
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Requests"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>

                            <Button Content="+"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CreateRequestCommand}"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>

                        <!-- Request list -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Requests}"
                                 SelectedItem="{Binding SelectedRequest}">

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ApiRequestModel">
                                    <Grid ColumnDefinitions="*,Auto"
                                          Margin="0,2">

                                        <!-- Click request itself: open normal visual/data workspace -->
                                        <Button Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Content="{Binding Name}"
                                                Command="{ReflectionBinding DataContext.OpenRequestCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"/>

                                        <!-- Click request menu: edit/delete -->
                                        <Button Grid.Column="1"
                                                Content="⋯"
                                                Width="32"
                                                Margin="6,0,0,0">

                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Edit"
                                                              Command="{ReflectionBinding DataContext.EditRequestCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>

                                                    <MenuItem Header="Delete"
                                                              Command="{ReflectionBinding DataContext.DeleteRequestCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>

                                        </Button>

                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- LEVEL 3: main content area -->
        <Grid Grid.Column="1">

            <!-- SOURCE EDITOR MODE -->
            <Border Padding="16"
                    IsVisible="{Binding IsSourceEditorOpen}">
<ScrollViewer>
                <ContentControl Content="{Binding SourceConfiguratorVm}"/>
</ScrollViewer>
            </Border>

            <!-- REQUEST EDITOR MODE -->
            <Border Padding="16"
                    IsVisible="{Binding IsRequestEditorOpen}">
<ScrollViewer>
                <ContentControl Content="{Binding RequestConfiguratorVm}"/>
</ScrollViewer>
            </Border>

            <!-- REQUEST WORKSPACE MODE -->
            <Grid RowDefinitions="Auto,*"
                  IsVisible="{Binding IsRequestWorkspaceVisible}">

                
                <!-- Request workspace tabs -->
                <Border Grid.Row="0"
                        Background="{StaticResource SidebarBackgroundBrush}"
                        Padding="8">

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <Button Content="Data Dashboard"
                                Command="{Binding NavigateSourceContentCommand}"
                                CommandParameter="{x:Static models:SourceNavigationPosition.DataDashboard}"/>

                        <Button Content="Dashboard Designer"
                                Command="{Binding NavigateSourceContentCommand}"
                                CommandParameter="{x:Static models:SourceNavigationPosition.DashboardDesigner}"/>

                    </StackPanel>
                </Border>

                <!-- Dynamic request workspace content -->
                <Border Grid.Row="1"
                        Padding="16">
<ScrollViewer>
                    <ContentControl Content="{Binding SourceNavigationService.CurrentViewModel}"/>
</ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>