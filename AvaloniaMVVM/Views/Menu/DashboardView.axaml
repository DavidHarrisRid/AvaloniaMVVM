<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AvaloniaMVVM.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaMVVM.ViewModels.Menu"
             mc:Ignorable="d"
             x:Name="Root"
             x:DataType="vm:DashboardVm"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="AvaloniaMVVM.Views.Menu.DashboardView">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Resizable tree column -->
            <ColumnDefinition Width="380"
                              MinWidth="300"/>

            <!-- Mouse draggable splitter -->
            <ColumnDefinition Width="4"/>

            <!-- Main workspace -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOURCE / REQUEST TREE -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelAltBrush}">

            <Grid RowDefinitions="Auto,*">

                <!-- Tree header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelColor}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{DynamicResource SourcesTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{DynamicResource SourcesSubtitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="icon accent"
                                Content="+"
                                ToolTip.Tip="{DynamicResource CreateSourceAction}"
                                Command="{Binding CreateSourceCommand}"/>
                    </Grid>
                </Border>

                <!-- Independent tree scroll area -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding Sources}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ApiSourceModel">

                                <StackPanel>

                                    <!-- SOURCE NODE -->
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          Margin="5,2"
                                          ColumnSpacing="5">

                                        <!-- Full-width source row button until the action buttons -->
                                        <Button Grid.Column="0"
                                                Classes="listRow"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="7,6"
                                                Command="{ReflectionBinding DataContext.ToggleSourceCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">

                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="8"
                                                  HorizontalAlignment="Stretch">

                                                <!-- Closed indicator -->
                                                <TextBlock Grid.Column="0"
                                                           Width="18"
                                                           Text="▸"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           IsVisible="{Binding !IsExpanded}"/>

                                                <!-- Open indicator -->
                                                <TextBlock Grid.Column="0"
                                                           Width="18"
                                                           Text="▾"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           IsVisible="{Binding IsExpanded}"/>

                                                <StackPanel Grid.Column="1"
                                                            Spacing="2">

                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Text="{Binding DefaultBaseUrl}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Physical request button -->
                                        <Button Grid.Column="1"
                                                Classes="icon"
                                                Content="+"
                                                ToolTip.Tip="{DynamicResource CreateRequestAction}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Command="{ReflectionBinding DataContext.CreateRequestForSourceCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"/>

                                        <!-- Source menu -->
                                        <Button Grid.Column="2"
                                                Classes="icon"
                                                Content="{DynamicResource MoreActions}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="{DynamicResource EditAction}"
                                                              Command="{ReflectionBinding DataContext.EditSourceCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>

                                                    <MenuItem Header="{DynamicResource DeleteAction}"
                                                              Command="{ReflectionBinding DataContext.DeleteSourceCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>

                                        </Button>
                                    </Grid>

                                    <!-- REQUEST CHILDREN -->
                                    <ItemsControl ItemsSource="{Binding ApiRequests}"
                                                  IsVisible="{Binding IsExpanded}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ApiRequestModel">

                                                <Grid ColumnDefinitions="*,Auto"
                                                      Margin="30,1,5,1"
                                                      ColumnSpacing="5">

                                                    <!-- Full-width request row button until the menu button -->
                                                    <Button Grid.Column="0"
                                                            Classes="listRow"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="7,5"
                                                            Command="{ReflectionBinding DataContext.OpenRequestCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}">

                                                        <Grid ColumnDefinitions="Auto,*"
                                                              ColumnSpacing="8"
                                                              HorizontalAlignment="Stretch">

                                                            <TextBlock Grid.Column="0"
                                                                       Text="•"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"/>

                                                            <StackPanel Grid.Column="1"
                                                                        Spacing="2">

                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>

                                                                <TextBlock Text="{Binding HttpMethod}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Request menu -->
                                                    <Button Grid.Column="1"
                                                            Classes="icon"
                                                            Content="{DynamicResource MoreActions}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">

                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuItem Header="{DynamicResource EditAction}"
                                                                          Command="{ReflectionBinding DataContext.EditRequestCommand, ElementName=Root}"
                                                                          CommandParameter="{Binding}"/>

                                                                <MenuItem Header="{DynamicResource DeleteAction}"
                                                                          Command="{ReflectionBinding DataContext.DeleteRequestCommand, ElementName=Root}"
                                                                          CommandParameter="{Binding}"/>
                                                            </MenuFlyout>
                                                        </Button.Flyout>

                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Resizable splitter between tree and main workspace -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      Background="{DynamicResource PanelBorderBrush}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"/>

        <!-- Main content area -->
        <Border Grid.Column="2"
                Background="{DynamicResource AppBackgroundBrush}">

            <Grid RowDefinitions="Auto,*">

                <!-- Main content header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelColor}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">

                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel Spacing="2">
                            <TextBlock Text="{DynamicResource RequestWorkspaceTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{DynamicResource RequestWorkspaceSubtitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    IsVisible="{Binding IsRequestWorkspaceVisible}">

                            <Button Classes="tab"
                                    Content="{DynamicResource DataDashboardTab}"
                                    Command="{Binding NavigateSourceContentCommand}"
                                    CommandParameter="{x:Static models:SourceNavigationPosition.DataDashboard}"/>

                            <Button Classes="tab"
                                    Content="{DynamicResource DashboardDesignerTab}"
                                    Command="{Binding NavigateSourceContentCommand}"
                                    CommandParameter="{x:Static models:SourceNavigationPosition.DashboardDesigner}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Independent main scroll region -->
                <Grid Grid.Row="1"
                      Background="{DynamicResource AppBackgroundBrush}">

                    <ScrollViewer IsVisible="{Binding IsSourceEditorOpen}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Border Padding="20">
                            <ContentControl Content="{Binding SourceConfiguratorVm}"/>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer IsVisible="{Binding IsRequestEditorOpen}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Border Padding="20">
                            <ContentControl Content="{Binding RequestConfiguratorVm}"/>
                        </Border>
                    </ScrollViewer>

                    <ScrollViewer IsVisible="{Binding IsRequestWorkspaceVisible}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">

                        <Border Padding="20">
                            <ContentControl Content="{Binding SourceNavigationService.CurrentViewModel}"/>
                        </Border>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>