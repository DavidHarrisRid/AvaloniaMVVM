<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AvaloniaMVVM.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaMVVM.ViewModels.Menu"
             mc:Ignorable="d"
             x:Name="Root"
             x:DataType="vm:DashboardVm"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="AvaloniaMVVM.Views.Menu.DashboardView">
    
    <Border Padding="0,2,0,0" Background="{DynamicResource PanelBorderBrush}">
            <Grid Background="{DynamicResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560"
                                  MinWidth="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
    
            <!-- Left source/request area -->
            <Grid Grid.Column="0"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="1"
                  Background="{DynamicResource PanelColor}">
    
                <!-- Sources panel -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PanelAltBrush}">
    
                    <Grid RowDefinitions="Auto,*">
    
                        <Border Grid.Row="0"
                                Background="{DynamicResource PanelColor}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,10">
    
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{DynamicResource SourcesTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
    
                                    <TextBlock Text="{DynamicResource SourcesSubtitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
    
                                <Button Grid.Column="1"
                                        Classes="icon accent"
                                        Content="+"
                                        ToolTip.Tip="{DynamicResource CreateSourceAction}"
                                        Command="{Binding CreateSourceCommand}"/>
                            </Grid>
                        </Border>
    
                        <!-- This ListBox is independently scrollable. -->
                        <ListBox Grid.Row="1"
                                 Classes="navList"
                                 ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ApiSourceModel">
    
                                    <Grid ColumnDefinitions="*,Auto"
                                          Margin="6,3">
    
                                        <!-- Full source row is clickable through the ListBoxItem selection. -->
                                        <Border Grid.Column="0"
                                                Padding="10,8"
                                                CornerRadius="6"
                                                Background="Transparent">
    
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
    
                                                <TextBlock Text="{Binding DefaultBaseUrl}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
    
                                        <Button Grid.Column="1"
                                                Classes="icon"
                                                Content="{DynamicResource MoreActions}"
                                                Margin="6,0,0,0">
    
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="{DynamicResource EditAction}"
                                                              Command="{ReflectionBinding DataContext.EditSourceCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>
    
                                                    <MenuItem Header="{DynamicResource DeleteAction}"
                                                              Command="{ReflectionBinding DataContext.DeleteSourceCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
    
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
    
                <!-- Requests panel -->
                <Border Grid.Column="1"
                        Background="{DynamicResource PanelAltBrush}">
    
                    <Grid RowDefinitions="Auto,*">
    
                        <Border Grid.Row="0"
                                Background="{DynamicResource PanelColor}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,10">
    
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{DynamicResource RequestsTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
    
                                    <TextBlock Text="{DynamicResource RequestsSubtitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
    
                                <Button Grid.Column="1"
                                        Classes="icon accent"
                                        Content="+"
                                        ToolTip.Tip="{DynamicResource CreateRequestAction}"
                                        Command="{Binding CreateRequestCommand}"/>
                            </Grid>
                        </Border>
    
                        <!-- This ListBox is independently scrollable. -->
                        <ListBox Grid.Row="1"
                                 Classes="navList"
                                 ItemsSource="{Binding Requests}"
                                 SelectedItem="{Binding SelectedRequest}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ApiRequestModel">
    
                                    <Grid ColumnDefinitions="*,Auto"
                                          Margin="6,3">
    
                                        <Button Grid.Column="0"
                                                Classes="listRow"
                                                Command="{ReflectionBinding DataContext.OpenRequestCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
    
                                            <Grid RowDefinitions="Auto,Auto"
                                                  RowSpacing="3"
                                                  HorizontalAlignment="Stretch">
    
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
    
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding HttpMethod}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Button>
    
                                        <Button Grid.Column="1"
                                                Classes="icon"
                                                Content="{DynamicResource MoreActions}"
                                                Margin="6,0,0,0">
    
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="{DynamicResource EditAction}"
                                                              Command="{ReflectionBinding DataContext.EditRequestCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>
    
                                                    <MenuItem Header="{DynamicResource DeleteAction}"
                                                              Command="{ReflectionBinding DataContext.DeleteRequestCommand, ElementName=Root}"
                                                              CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
    
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
    
            <!-- Main content area -->
            <Border Grid.Column="1"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1,0,0,0">
    
                <Grid RowDefinitions="Auto,*">
    
                    <!-- Main content header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelColor}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
    
                        <Grid ColumnDefinitions="*,Auto">
    
                            <StackPanel Spacing="2">
                                <TextBlock Text="{DynamicResource RequestWorkspaceTitle}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
    
                                <TextBlock Text="{DynamicResource RequestWorkspaceSubtitle}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
    
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        IsVisible="{Binding IsRequestWorkspaceVisible}">
    
                                <Button Classes="tab"
                                        Content="{DynamicResource DataDashboardTab}"
                                        Command="{Binding NavigateSourceContentCommand}"
                                        CommandParameter="{x:Static models:SourceNavigationPosition.DataDashboard}"/>
    
                                <Button Classes="tab"
                                        Content="{DynamicResource DashboardDesignerTab}"
                                        Command="{Binding NavigateSourceContentCommand}"
                                        CommandParameter="{x:Static models:SourceNavigationPosition.DashboardDesigner}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
    
                    <!-- Independent main scroll region -->
                    <Grid Grid.Row="1"
                          Background="{DynamicResource AppBackgroundBrush}">
    
                        <ScrollViewer IsVisible="{Binding IsSourceEditorOpen}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
    
                            <Border Padding="20">
                                <ContentControl Content="{Binding SourceConfiguratorVm}"/>
                            </Border>
                        </ScrollViewer>
    
                        <ScrollViewer IsVisible="{Binding IsRequestEditorOpen}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
    
                            <Border Padding="20">
                                <ContentControl Content="{Binding RequestConfiguratorVm}"/>
                            </Border>
                        </ScrollViewer>
    
                        <ScrollViewer IsVisible="{Binding IsRequestWorkspaceVisible}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
    
                            <Border Padding="20">
                                <ContentControl Content="{Binding SourceNavigationService.CurrentViewModel}"/>
                            </Border>
                        </ScrollViewer>
    
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>