<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaMVVM.Views.Menu.DashboardView">
    
        
    <Grid>
        <!-- Two columns: Sidebar + Content -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" MinWidth="150" MaxWidth="200"/>
            <ColumnDefinition Width="80*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
      
        <!-- Side Bar -->
        <Border
            Grid.Column="0"
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="{StaticResource SidebarBackgroundBrush}"
            Padding="10">
            
            <StackPanel Spacing="12">
                
                
            </StackPanel>
            
        </Border>
        
        <Border
            Grid.Column="1"
            Grid.Row="0"
            Background="{StaticResource SidebarBackgroundBrush}"
            Padding="10">
            
            <StackPanel Spacing="12" Orientation="Horizontal">
                <Button HorizontalAlignment="Stretch"
                        Classes="sidebar"
                        Classes.selected="{Binding IsDashboardSelected}"
                        Content="{DynamicResource DashboardTitle}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static models:NavigationPosition.Dashboard}" />

                
            </StackPanel>
            
        </Border>
        
    </Grid>
    
</UserControl>
