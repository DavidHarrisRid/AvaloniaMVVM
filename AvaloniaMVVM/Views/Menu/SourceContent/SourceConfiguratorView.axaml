<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaMVVM.ViewModels.Menu.SourceContent"
             mc:Ignorable="d"
             x:DataType="vm:SourceConfiguratorVm"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="AvaloniaMVVM.Views.Menu.SourceContent.SourceConfiguratorView">

    <ScrollViewer>
        <StackPanel Spacing="12"
                    MaxWidth="700">

            <TextBlock Text="Source Configurator"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="Changes are only written to the source after clicking Save."/>

            <TextBlock Text="Name"/>
            <TextBox Text="{Binding Name, Mode=TwoWay}"/>

            <TextBlock Text="Default Base URL"/>
            <TextBox Text="{Binding DefaultBaseUrl, Mode=TwoWay}"/>

            <TextBlock Text="Description"/>
            <TextBox Text="{Binding Description, Mode=TwoWay}"
                     AcceptsReturn="True"
                     MinHeight="80"/>

            <TextBlock Text="Authentication Type"/>
            <TextBox Text="{Binding AuthenticationType, Mode=TwoWay}"/>

            <TextBlock Text="API Key"/>
            <TextBox Text="{Binding ApiKey, Mode=TwoWay}"/>

            <TextBlock Text="Default Header"/>
            <TextBox Text="{Binding DefaultHeader, Mode=TwoWay}"
                     AcceptsReturn="True"
                     MinHeight="80"/>

            <StackPanel Orientation="Horizontal"
                        Spacing="8">

                <Button Content="Save Source"
                        Command="{Binding SaveCommand}"/>

                <TextBlock Text="{Binding SaveMessage}"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>